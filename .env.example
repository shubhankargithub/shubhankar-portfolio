# Canonical production URL used for metadata, sitemap and robots.txt.
# Set this in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://shubhankarchavan.vercel.app

# Optional path prefix for GitHub Pages project sites, e.g. /shubhankar-portfolio.
# Leave empty for Vercel, custom domains and root-domain deployments.
NEXT_PUBLIC_BASE_PATH=
